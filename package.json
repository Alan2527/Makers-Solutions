{
  "name": "makers-solutions-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Prueba tecnica QA Full Stack Sr - Makers. Automatizacion de smoke test de login (SauceDemo), pruebas funcionales de API (reqres.in) y modulo funcional MakersPay.",
  "scripts": {
    "test": "cypress run",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "cy:open": "cypress open",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npm run test ; npm run allure:generate"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.34.0",
    "allure-cypress": "^3.0.0",
    "cypress": "^14.0.0"
  }
}
